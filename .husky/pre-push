set -e

# The full gate. Anything that fails here would otherwise reach main.
#
# typecheck        — hard gate, must be zero errors
# lint             — hard gate, must be zero errors
# typecheck:ratchet — stricter flags; count may fall, never rise
# lint:ratchet     — lint warnings; count may fall, never rise
# test             — unit and integration suites
#
# E2E is deliberately not here: it needs a built app and a browser, which is
# too slow for a push. Run it in CI and before a release.

pnpm run typecheck
pnpm run lint
pnpm run typecheck:ratchet
pnpm run lint:ratchet
pnpm run test
