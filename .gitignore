# ─── Secrets — never commit these ───────────────────────────────────────────
# .env.example is the only tracked env template; every real env file is
# ignored, including uncommon-but-real variants (.env.production, .env.vault,
# .env.local, etc.) via the wildcard. If you ever need a new example file,
# name it *.env.example and it will still be ignored unless explicitly
# negated below.
.env
.env.*
!.env.example
!.env.*.example

# Explicit secret-shaped files, regardless of where they show up in the tree.
# These patterns match by shape (private key, credential dump, token file),
# not by a specific provider, so a new cloud provider's default filename is
# still caught.
*.pem
*.key
*.p12
*.pfx
*.jks
*.crt
id_rsa*
id_ecdsa*
id_ed25519*
*credentials*.json
*service-account*.json
*secrets*.yml
*secrets*.yaml
.netrc
*.tfstate
*.tfstate.*

# `.npmrc` is secret-shaped — it's where `npm login` writes `_authToken`. But
# this repo's own root .npmrc holds nothing but pnpm resolution settings and is
# meant to be shared, so it is negated explicitly rather than left as a file
# that is "ignored" while actually being tracked (a tracked file ignores
# .gitignore entirely, so the rule was buying no safety at all). Any *other*
# .npmrc in the tree — including the user-level one a login would write — stays
# ignored, and check-secrets.mjs greps for `_authToken` so a credential added
# to the tracked file is still caught before it can be committed.
.npmrc
!/.npmrc

# Supabase CLI local state (project ref, pooler url, version cache, access token).
supabase/.temp/
.supabase/

# ─── AI coding tool state — local only, never project-shared ────────────────
# These directories can hold session transcripts, credentials, or local
# config for AI coding assistants. None of it belongs in a shared repo.
.claude/
.cursor/
.aider*
.windsurf/
.codeium/

# ─── Node / package managers ─────────────────────────────────────────────────
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs
*.log

# ─── Build output ────────────────────────────────────────────────────────────
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Vercel / nitro build output
.vercel
.dev.vars

# ─── Test + tooling output ───────────────────────────────────────────────────
coverage
playwright-report
test-results
.turbo
.eslintcache

# ─── Editor / IDE ─────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
